<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#ffffff"
    >
    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginHorizontal="20dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/splash_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
<LinearLayout

    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:id="@+id/ll_app_title"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginBottom="10dp"
    app:layout_constraintBottom_toBottomOf="@id/iv_app_icon"
    app:layout_constraintStart_toStartOf="parent"

>

    <TextView
        android:id="@+id/tv_app_title1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="GPS "
        android:textColor="#3972FE"
        android:textSize="38sp" />
    <TextView
        android:text="@string/tracker"
        android:textSize="38sp"
        android:fontFamily="@font/inter_bold"
        android:textColor="#1E1F4B"
        android:id="@+id/tv_app_title2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

</LinearLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_app_icon"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/gps_splash_loading" />
    <TextView
        android:text="This may contain ads"
        android:textSize="18sp"
        android:layout_marginBottom="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:fontFamily="@font/inter_bold"
        android:textColor="#1E1F4B"
        android:id="@+id/tv_app_title3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

</androidx.constraintlayout.widget.ConstraintLayout>